   {
    "name": "Refresher",
    "compareWith": "Escalating Exposure",
    "claim": "should_be_more_obvious",
    "reason": "Refresher is a famous, iconic 6,400-soul item with a simple, memorable effect that players recall immediately. It should score at least as obvious as Escalating Exposure, and probably more so than Spirit Burn.",
    "outcome": "applied"
   },
   {
    "name": "Spirit Burn",
    "compareWith": "Ethereal Shift",
    "claim": "should_be_more_obscure",
    "reason": "Spirit Burn sits in the top 10-point tier, which is too obvious for a niche situational item. It is less associated with the 6,400 price than Ethereal Shift or Cheat Death, so it belongs in a higher-scoring tier.",
    "outcome": "applied"
   },
   {
    "name": "Cheat Death",
    "compareWith": "Leech",
    "claim": "should_be_more_obvious",
    "reason": "Cheat Death is a very well-known, defining defensive item whose name and effect are memorable. It should be easier to recall than Leech or Vampiric Burst and not sit in the same 60-point tier.",
    "outcome": "applied"
   },
   {
    "name": "Transcendent Cooldown",
    "compareWith": "Plated Armor",
    "claim": "should_be_more_obscure",
    "reason": "Transcendent Cooldown is a plain upgraded-tier stat item with a generic effect, and players seldom remember its price. It is likely not more obvious than Plated Armor and probably should not share the top 10-point tier with Boundless Spirit.",
    "outcome": "rejected-by-comparison"
   },
   {
    "name": "Lightning Scroll",
    "compareWith": "Focus Lens",
    "claim": "should_be_more_obvious",
    "reason": "Lightning Scroll is not clearly rarer than Focus Lens, Armor Piercer or Vortex Web. Those items are equally niche, so a unique 100-point slot for Lightning Scroll is not justified and it should sit in the 85 tier.",
    "outcome": "applied-by-data"
   }
