  "review": [
   {
    "name": "Sprint Boots",
    "compareWith": "Melee Lifesteal",
    "claim": "should_be_more_obscure",
    "reason": "Sprint Boots has a double letter only in 'Boots' (oo), which is easy to notice. But the main reason is that Melee Lifesteal has 'ee' in Melee and ties just as strongly, so equal 10 pts hides that Sprint Boots is a more iconic item than Melee Lifesteal. Melee Lifesteal is less recognized, so it should be pricier.",
    "outcome": "rejected-by-comparison"
   },
   {
    "name": "Superior Cooldown",
    "compareWith": "Compress Cooldown",
    "claim": "should_be_more_obscure",
    "reason": "Superior Cooldown's double letters come only from 'oo' in Cooldown, and Compress Cooldown has both 'ss' and 'oo'. Players scanning for doubles find Compress's 'ss' easily, so it is as obvious; Superior's 10 pts versus Compress's 30 is too wide a gap.",
    "outcome": "applied"
   },
   {
    "name": "Lightning Scroll",
    "compareWith": "Golden Goose Egg",
    "claim": "should_be_more_obvious",
    "reason": "Lightning Scroll has a double 'll' in Scroll? No, it has none; but Golden Goose Egg has 'oo' and is a memorable, distinctive name, so it should not tie with the bottom of the list. Golden Goose Egg should be rarer than 85 or at least comparable, and Lightning Scroll is unlikely to be answered at all.",
    "outcome": "rejected-by-comparison"
   },
   {
    "name": "Blood Tribute",
    "compareWith": "Spellslinger",
    "claim": "should_be_more_obvious",
    "reason": "Blood has an obvious 'oo' and is a well-known item name, so players scanning for double letters would find it more readily than Spellslinger's 'll' buried in a long compound name. It deserves a lower price.",
    "outcome": "rejected-by-comparison"
   },
   {
    "name": "Spirit Shredder",
    "compareWith": "Hollow Point",
    "claim": "should_be_more_obvious",
    "reason": "Hollow has a clear 'll' exactly like the example Billy, so it is strongly tied to the question and should be cheaper than 85, while Spirit Shredder has only 'dd' and is less obvious.",
    "outcome": "rejected-by-comparison"
   }
  ]
