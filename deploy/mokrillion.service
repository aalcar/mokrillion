# systemd unit for the Discord bot. Install: see README "Hosting".
[Unit]
Description=Mokrillion Discord bot
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/home/bot/mokrillion
ExecStart=/usr/bin/npm run bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
